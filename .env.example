# Password of the database. Do not use the characters ; and = in it.
# Make one with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Port on the host for the web server.
SAMIZDAT_PORT=8080

# Address on the host where the web server listens. Use 127.0.0.1 if the proxy is on the same machine.
SAMIZDAT_BIND=0.0.0.0

# Attempts to sign in and to register in one minute from one IP address. 0 removes the limit.
SAMIZDAT_LOGIN_ATTEMPTS=10

# Addresses of the reverse proxy: IP addresses or networks such as 192.168.1.0/24, separated by commas.
# The server reads X-Forwarded-For and X-Forwarded-Proto only from these addresses.
# Empty: the server does not read these headers from any address.
SAMIZDAT_PROXY=
