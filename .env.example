# Password of the database administrator (the role samizdat). Do not use the characters ; and = in it.
# Make one with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Password of the role samizdat_app. The site connects to the database with this role.
# Use only letters and digits. When it is empty, deploy/update.sh makes one.
SAMIZDAT_DB_PASSWORD=

# Port on the host for the web server.
SAMIZDAT_PORT=8080

# Address on the host where the web server listens. With 127.0.0.1, only programs on this machine
# can connect, for example a reverse proxy. Use 0.0.0.0 if the proxy is on a different machine.
# Docker adds its own firewall rules for the port, so ufw does not close it.
SAMIZDAT_BIND=127.0.0.1

# Attempts to sign in and to register in one minute from one IP address. 0 removes the limit.
SAMIZDAT_LOGIN_ATTEMPTS=10

# Addresses of the reverse proxy: IP addresses or networks such as 192.168.1.0/24, separated by commas.
# The server reads X-Forwarded-For and X-Forwarded-Proto only from these addresses.
# Empty: the server does not read these headers from any address.
SAMIZDAT_PROXY=
